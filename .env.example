# Environment
APP_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl

# Dedicated database for destructive integration tests.
# Its name must end with `_test` or the integration test suite refuses to run.
TEST_DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl_test

# External APIs
FPL_API_BASE_URL=https://fantasy.premierleague.com/api

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
